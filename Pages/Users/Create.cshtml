@page "/users/create"
@model WebApp.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Nuevo usuario";
}
<div class="mb-4"><h1 class="h2 mb-1">Nuevo usuario</h1><p class="text-body-secondary mb-0">Crea una cuenta y asigna su rol inicial.</p></div>
<section class="card border-0 shadow-sm"><div class="card-body p-4"><form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.FirstName" class="form-label"></label><input asp-for="Input.FirstName" class="form-control" /><span asp-validation-for="Input.FirstName" class="text-danger small"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.LastName" class="form-label"></label><input asp-for="Input.LastName" class="form-control" /><span asp-validation-for="Input.LastName" class="text-danger small"></span></div></div>
    <div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Input.UserName" class="form-label">Nombre de usuario</label><input asp-for="Input.UserName" class="form-control" autocomplete="username" /><span asp-validation-for="Input.UserName" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Input.Password" class="form-label">Contraseña inicial</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="text-danger small"></span><div class="form-text">Debe cumplir la política de contraseñas vigente.</div></div>
    <div class="mb-4"><label asp-for="Input.Role" class="form-label">Rol inicial</label><select asp-for="Input.Role" class="form-select"><option value="">Selecciona un rol</option>@foreach (var role in Model.Roles) { <option value="@role">@role</option> }</select><span asp-validation-for="Input.Role" class="text-danger small"></span></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Users/Index">Cancelar</a><button type="submit" class="btn btn-primary">Crear usuario</button></div>
</form></div></section>
