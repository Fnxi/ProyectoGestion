@page "/users/{id}/edit"
@model WebApp.Pages.Users.EditModel
@{
    ViewData["Title"] = "Editar usuario";
}
<div class="mb-4"><h1 class="h2 mb-1">Editar usuario</h1><p class="text-body-secondary mb-0">Actualiza los datos y roles de la cuenta.</p></div>
<section class="card border-0 shadow-sm"><div class="card-body p-4"><form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.FirstName" class="form-label"></label><input asp-for="Input.FirstName" class="form-control" /><span asp-validation-for="Input.FirstName" class="text-danger small"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.LastName" class="form-label"></label><input asp-for="Input.LastName" class="form-control" /><span asp-validation-for="Input.LastName" class="text-danger small"></span></div></div>
    <div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /><span asp-validation-for="Input.Email" class="text-danger small"></span></div>
    <div class="mb-4"><label asp-for="Input.UserName" class="form-label"></label><input asp-for="Input.UserName" class="form-control" /><span asp-validation-for="Input.UserName" class="text-danger small"></span></div>
    <fieldset class="mb-4"><legend class="h6">Roles</legend>@foreach (var role in Model.Roles) { <div class="form-check"><input class="form-check-input" type="checkbox" name="Input.Roles" value="@role" id="role-@role" @(Model.Input.Roles.Contains(role) ? "checked" : null) /><label class="form-check-label" for="role-@role">@role</label></div> }<span asp-validation-for="Input.Roles" class="text-danger small"></span></fieldset>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Users/Index">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cambios</button></div>
</form></div></section>
