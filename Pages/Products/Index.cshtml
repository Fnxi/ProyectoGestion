@page "/products"
@model WebApp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Productos</h1>
        <p class="text-body-secondary mb-0">Gestiona el catálogo de productos.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Products/Create">Nuevo producto</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<section class="card border-0 shadow-sm">
    @if (Model.Products.Count == 0)
    {
        <div class="card-body p-4 text-center">
            <h2 class="h5">No hay productos registrados</h2>
            <p class="text-body-secondary mb-3">Crea el primer producto para comenzar.</p>
            <a class="btn btn-primary" asp-page="/Products/Create">Crear producto</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-end">Stock</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td class="fw-semibold">@product.Name</td>
                            <td class="product-description">@(string.IsNullOrEmpty(product.Description) ? "—" : product.Description)</td>
                            <td class="text-end">@product.Price.ToString("C")</td>
                            <td class="text-end">@product.Stock</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Products/Details" asp-route-id="@product.Id">Ver</a>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Products/Edit" asp-route-id="@product.Id">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-page="/Products/Delete" asp-route-id="@product.Id">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
