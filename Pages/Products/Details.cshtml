@page "/products/{id:int}"
@model WebApp.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Detalle del producto";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">@Model.Product.Name</h1><p class="text-body-secondary mb-0">Detalle del producto</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Products/Index">Volver</a><a class="btn btn-primary" asp-page="/Products/Edit" asp-route-id="@Model.Product.Id">Editar</a></div>
</div>
<section class="card border-0 shadow-sm"><div class="card-body p-4"><dl class="row mb-0">
    <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9 description-content">@(string.IsNullOrEmpty(Model.Product.Description) ? "Sin descripción" : Model.Product.Description)</dd>
    <dt class="col-sm-3">Precio</dt><dd class="col-sm-9">@Model.Product.Price.ToString("C")</dd>
    <dt class="col-sm-3">Stock</dt><dd class="col-sm-9">@Model.Product.Stock</dd>
    <dt class="col-sm-3">Creado</dt><dd class="col-sm-9">@Model.Product.CreatedAt.ToLocalTime().ToString("g")</dd>
    <dt class="col-sm-3">Última actualización</dt><dd class="col-sm-9">@Model.Product.UpdatedAt.ToLocalTime().ToString("g")</dd>
</dl></div></section>
