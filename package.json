{
  "name": "webapp-api-tests",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^30.2.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 60000
  },
  "dependencies": {
    "bootstrap": "5.3.3"
  }
}
